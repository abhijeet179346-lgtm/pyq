# Caddy terminates HTTPS and proxies to gunicorn. install_caddy.sh fills in the
# placeholders and appends the site blocks (domain, www redirect, bare IP).
{
	# Browsers send no SNI when visiting a bare IP; serve the IP certificate then.
	default_sni __PUBLIC_IP__
}

(app) {
	request_body {
		max_size 100MB # admin PDF uploads
	}
	encode zstd gzip

	handle_path /static/* {
		root * /opt/pyq/app/staticfiles
		header Cache-Control "public, max-age=604800"
		file_server
	}
	# Private media is served only through authenticated Django views.
	handle /private-media/* {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				read_timeout 180s
			}
		}
	}
	log {
		output stderr
	}
}

# Let's Encrypt issues IP-address certificates only on its short-lived (~6 day) profile.
(ip_tls) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}
