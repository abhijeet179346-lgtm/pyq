# Copy to .env and fill in; Django loads .env from the project root at startup.
# Variables already set in the shell take precedence; blank values are ignored.

# --- Django (required) ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
PYQ_CORE_ORIGIN=http://localhost:8765
PYQ_TENANT_BASE_DOMAIN=localhost
# PYQ_MEDIA_ROOT=/absolute/path/to/private-media

# --- OpenAI: AI tutor, scan OCR (vision), embeddings ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PYQ_TUTOR_MODEL=gpt-6-luna
PYQ_VISION_MODEL=gpt-6-luna
# Luna is a chat model, not an embedding model; keep a dedicated embedding model.
PYQ_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (optional; tutor falls back to keyword search) ---
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- Google OAuth (optional); register this exact callback:
# http://localhost:8765/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional; local default prints mail in the terminal) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=PYQNet <noreply@pyqnet.com>
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# Feedback notifications: comma-separated recipients; optionally choose a separate backend.
# FEEDBACK_NOTIFICATION_RECIPIENTS=reviewer@example.com,admin@example.com
# FEEDBACK_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# FEEDBACK_FROM_EMAIL=support@example.com

# Postgres (e.g. Supabase). Leave blank to use db.sqlite3.
DATABASE_URL=
